{
  "name": "hexalith-conversations",
  "version": "0.0.0",
  "private": true,
  "description": "Semantic release and commit validation for Hexalith.Conversations",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "commitlint": "commitlint --config commitlint.config.mjs",
    "test": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  }
}
