{
  "name": "hexalith-conversations",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "commitlint": "commitlint --config commitlint.config.mjs",
    "test": "python3 -m unittest discover -s tests/tooling -p 'test_*.py' -v",
    "verify:release-plan": "node scripts/verify-semantic-release-plan.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "25.0.9"
  }
}
