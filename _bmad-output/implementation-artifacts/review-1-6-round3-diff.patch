+
+    private sealed class FakeParticipantDirectory : IParticipantDirectory
+    {
+        public int CallCount { get; private set; }
+
+        public ValueTask<ParticipantDirectoryValidation> ValidateParticipantAsync(
+            TenantId tenantId,
