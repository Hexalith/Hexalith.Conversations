+        replay.Outcome.ParticipantPartyId.ShouldBe(outcome.ParticipantPartyId);
+        replay.Outcome.RejectionCode.ShouldBeNull();
+        replay.Outcome.IsRetryable.ShouldBeFalse();
+        mutationCount.ShouldBe(0);
+    }
+
+    /// <summary>
