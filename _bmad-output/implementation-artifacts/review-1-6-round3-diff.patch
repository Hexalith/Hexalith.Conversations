+                    command.Metadata.TenantId,
+                    ConversationCommandType.AddParticipantCommand,
+                    command.ConversationId,
+                    auditHandle,
+                    auditHandle);
+            }
+
+            return ConversationIdempotencyOutcome.Rejection(
+                command.Metadata.SchemaVersion,
+                command.Metadata.TenantId,
+                ConversationCommandType.AddParticipantCommand,
+                command.ConversationId,
