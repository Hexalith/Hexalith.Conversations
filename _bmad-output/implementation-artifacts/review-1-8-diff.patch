diff --git a/tests/Hexalith.Conversations.Server.Tests/Queries/ConversationQueryHandlerTest.cs b/tests/Hexalith.Conversations.Server.Tests/Queries/ConversationQueryHandlerTest.cs
new file mode 100644
index 0000000..9de473f
