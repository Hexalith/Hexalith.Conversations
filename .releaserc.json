{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "bash scripts/validate-release-secrets.sh && bash scripts/validate-publication-preflight.sh ${nextRelease.version} verify",
        "prepareCmd": "python3 scripts/pack-release-packages.py ./nupkgs ${nextRelease.version} --source-revision $GITHUB_SHA && python3 scripts/validate-nuget-packages.py ./nupkgs --version ${nextRelease.version} --source-revision $GITHUB_SHA && python3 scripts/validate-consumer-package-references.py ./nupkgs",
        "publishCmd": "bash scripts/validate-release-secrets.sh && bash scripts/validate-publication-preflight.sh ${nextRelease.version} publish && python3 scripts/publish-release-packages.py ./nupkgs ${nextRelease.version} $GITHUB_SHA",
        "successCmd": "python3 scripts/verify-published-release.py ${nextRelease.version} $GITHUB_SHA"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "nupkgs/*.nupkg",
          "nupkgs/*.snupkg"
        ],
        "successCommentCondition": false
      }
    ]
  ]
}
