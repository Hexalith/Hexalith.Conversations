{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-story-contract-v1.schema.json",
  "title": "Conversations V9 Story Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planningCandidate",
    "authorities",
    "storyId",
    "title",
    "boundedOutcome",
    "predecessors",
    "rollbackBoundary",
    "candidateBinding",
    "authoritySectionSha256",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.v9-story-contract.v1" },
    "planningCandidate": { "$ref": "#/$defs/commit" },
    "authorities": { "$ref": "#/$defs/authorities" },
    "storyId": { "type": "string", "pattern": "^(?:[7-9]|1[0-5])\\.[1-4]$" },
    "title": { "type": "string", "minLength": 1 },
    "boundedOutcome": { "type": "string", "minLength": 1 },
    "predecessors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:6\\.2|(?:[7-9]|1[0-5])\\.[1-4])$" }
    },
    "rollbackBoundary": { "type": "string", "minLength": 1 },
    "candidateBinding": { "type": "string", "minLength": 1 },
    "entryInventory": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "authoritySectionSha256": { "$ref": "#/$defs/digest" },
    "finalRecordPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "contract"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-(?:[7-9]|1[0-5])\\.[1-4]-[0-9]{2}$" },
          "command": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "requiredResults": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"] }
          }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture"],
      "properties": {
        "epic": { "const": "epic-6-authority-2026-08-03-v10" },
        "architecture": { "const": "conversations-architecture-2026-08-03-v10" }
      }
    }
  }
}
