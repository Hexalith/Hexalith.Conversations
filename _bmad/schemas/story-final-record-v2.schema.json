{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/story-final-record-v2.schema.json",
  "title": "Conversations Story Final Record V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyId",
    "authority",
    "candidate",
    "predecessors",
    "inventory",
    "scenarios",
    "faultInjection",
    "outputs",
    "rollback",
    "summary",
    "renderedMarkdownSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hexalith.conversations.story-final-record.v2"
    },
    "storyId": {
      "$ref": "#/$defs/storyId"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "predecessors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:IR-0|6\\.2|(?:[7-9]|1[0-6])\\.[1-4])$"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "faultInjection": {
      "$ref": "#/$defs/faultInjection"
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "rollback": {
      "$ref": "#/$defs/rollback"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "renderedMarkdownSha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "storyId": {
      "type": "string",
      "pattern": "^(?:[7-9]|1[0-6])\\.[1-4]$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^AC-(?:[7-9]|1[0-6])\\.[1-4]-[0-9]{2}$"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "result": {
      "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"]
    },
    "blocker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epic",
        "architecture",
        "planningCandidate",
        "bundleDigest"
      ],
      "properties": {
        "epic": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "planningCandidate": {
          "$ref": "#/$defs/commit"
        },
        "bundleDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "gitlinks"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "gitlinks": {
          "$ref": "#/$defs/gitlinks"
        }
      }
    },
    "gitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "mode": {
          "const": "160000"
        }
      }
    },
    "gitlinkAiTools": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.AI.Tools"
        }
      }
    },
    "gitlinkBuilds": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Builds"
        }
      }
    },
    "gitlinkCommons": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Commons"
        }
      }
    },
    "gitlinkEventStore": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.EventStore"
        }
      }
    },
    "gitlinkFolders": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Folders"
        }
      }
    },
    "gitlinkFrontComposer": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.FrontComposer"
        }
      }
    },
    "gitlinkMemories": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Memories"
        }
      }
    },
    "gitlinkParties": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Parties"
        }
      }
    },
    "gitlinkProjects": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Projects"
        }
      }
    },
    "gitlinkTenants": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Tenants"
        }
      }
    },
    "gitlinks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/gitlinkAiTools" },
        { "$ref": "#/$defs/gitlinkBuilds" },
        { "$ref": "#/$defs/gitlinkCommons" },
        { "$ref": "#/$defs/gitlinkEventStore" },
        { "$ref": "#/$defs/gitlinkFolders" },
        { "$ref": "#/$defs/gitlinkFrontComposer" },
        { "$ref": "#/$defs/gitlinkMemories" },
        { "$ref": "#/$defs/gitlinkParties" },
        { "$ref": "#/$defs/gitlinkProjects" },
        { "$ref": "#/$defs/gitlinkTenants" }
      ],
      "items": false
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "command",
        "exitCode",
        "result",
        "blockers"
      ],
      "properties": {
        "scenarioId": {
          "$ref": "#/$defs/scenarioId"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "$ref": "#/$defs/exitCode"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "blockers": {
          "$ref": "#/$defs/blockers"
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedBlocker"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expectedBlocker": {
          "$ref": "#/$defs/blocker"
        }
      }
    },
    "faultInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fault"
          }
        }
      }
    },
    "outputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "markdown"
      ],
      "properties": {
        "json": {
          "$ref": "#/$defs/outputFile"
        },
        "markdown": {
          "$ref": "#/$defs/outputFile"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary"
      ],
      "properties": {
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "passed",
        "failed",
        "blocked",
        "skipped",
        "notRun"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "blocked": {
          "$ref": "#/$defs/count"
        },
        "skipped": {
          "$ref": "#/$defs/count"
        },
        "notRun": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
