{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/story-final-record-v2.schema.json",
  "title": "Conversations Story Final Record V2",
  "description": "Authority boundary: this schema validates document structure only; producers and verifiers must derive candidate, gitlink, scenario, output, and summary facts from committed evidence rather than caller-authored claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyId",
    "authority",
    "candidate",
    "predecessors",
    "inventory",
    "scenarios",
    "faultInjection",
    "outputs",
    "rollback",
    "summary",
    "renderedMarkdownSha256"
  ],
  "if": {
    "properties": {
      "storyId": {
        "const": "7.2"
      }
    },
    "required": [
      "storyId"
    ]
  },
  "then": {
    "required": [
      "measurements"
    ]
  },
  "else": {
    "not": {
      "required": [
        "measurements"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storyId": {
            "const": "7.3"
          }
        },
        "required": [
          "storyId"
        ]
      },
      "then": {
        "required": [
          "workflowIntegration"
        ]
      },
      "else": {
        "not": {
          "required": [
            "workflowIntegration"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "storyId": {
            "const": "7.4"
          }
        },
        "required": [
          "storyId"
        ]
      },
      "then": {
        "required": [
          "historicalVerification"
        ],
        "properties": {
          "faultInjection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "results"
            ],
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/observedFault"
                },
                "minItems": 13,
                "maxItems": 13,
                "uniqueItems": true,
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "COUNT"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "SUBMODULE_PATH"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "CANDIDATE"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "GITLINK"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "RESULT_MISSING"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "RESULT_STALE"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "RESULT_FAILED"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "RESULT_SKIPPED"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "RESULT_NOT_RUN"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "LEDGER_EMPTY"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "WORKFLOW_REMOVED"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "WORKFLOW_DISPLACED"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "id": {
                          "const": "MARKDOWN_DIGEST"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "historicalVerification"
          ]
        },
        "properties": {
          "faultInjection": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "storyId": {
            "const": "8.1"
          }
        },
        "required": [
          "storyId"
        ]
      },
      "then": {
        "required": [
          "uxDisposition"
        ]
      },
      "else": {
        "not": {
          "required": [
            "uxDisposition"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "storyId": {
            "const": "8.2"
          }
        },
        "required": [
          "storyId"
        ]
      },
      "then": {
        "required": [
          "uxValidation"
        ],
        "properties": {
          "faultInjection": {
            "$ref": "#/$defs/uxFaultInjection"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "uxValidation"
          ]
        },
        "if": {
          "properties": {
            "storyId": {
              "const": "7.4"
            }
          }
        },
        "then": {},
        "else": {
          "properties": {
            "faultInjection": {
              "$ref": "#/$defs/faultInjection"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "hexalith.conversations.story-final-record.v2"
    },
    "storyId": {
      "$ref": "#/$defs/storyId"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "predecessors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:IR-0|6\\.2|(?:[7-9]|1[0-6])\\.[1-4])$"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "faultInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/fault"
              },
              {
                "$ref": "#/$defs/observedFault"
              },
              {
                "$ref": "#/$defs/uxObservedFault"
              }
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "rollback": {
      "$ref": "#/$defs/rollback"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "renderedMarkdownSha256": {
      "$ref": "#/$defs/digest"
    },
    "measurements": {
      "$ref": "#/$defs/measurements"
    },
    "workflowIntegration": {
      "$ref": "#/$defs/workflowIntegration"
    },
    "historicalVerification": {
      "$ref": "#/$defs/historicalVerification"
    },
    "uxDisposition": {
      "$ref": "#/$defs/uxDisposition"
    },
    "uxValidation": {
      "$ref": "#/$defs/uxValidation"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "storyId": {
      "type": "string",
      "pattern": "^(?:[7-9]|1[0-6])\\.[1-4]$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^AC-(?:[7-9]|1[0-6])\\.[1-4]-[0-9]{2}$"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "not-applicable"
      ]
    },
    "blocker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epic",
        "architecture",
        "planningCandidate",
        "bundleDigest"
      ],
      "properties": {
        "epic": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "planningCandidate": {
          "$ref": "#/$defs/commit"
        },
        "bundleDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "gitlinks"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "gitlinks": {
          "$ref": "#/$defs/gitlinks"
        }
      }
    },
    "gitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "mode": {
          "const": "160000"
        }
      }
    },
    "gitlinkAiTools": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.AI.Tools"
        }
      }
    },
    "gitlinkBuilds": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Builds"
        }
      }
    },
    "gitlinkCommons": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Commons"
        }
      }
    },
    "gitlinkEventStore": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.EventStore"
        }
      }
    },
    "gitlinkFolders": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Folders"
        }
      }
    },
    "gitlinkFrontComposer": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.FrontComposer"
        }
      }
    },
    "gitlinkMemories": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Memories"
        }
      }
    },
    "gitlinkParties": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Parties"
        }
      }
    },
    "gitlinkProjects": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Projects"
        }
      }
    },
    "gitlinkTenants": {
      "$ref": "#/$defs/gitlink",
      "properties": {
        "path": {
          "const": "references/Hexalith.Tenants"
        }
      }
    },
    "gitlinks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        {
          "$ref": "#/$defs/gitlinkAiTools"
        },
        {
          "$ref": "#/$defs/gitlinkBuilds"
        },
        {
          "$ref": "#/$defs/gitlinkCommons"
        },
        {
          "$ref": "#/$defs/gitlinkEventStore"
        },
        {
          "$ref": "#/$defs/gitlinkFolders"
        },
        {
          "$ref": "#/$defs/gitlinkFrontComposer"
        },
        {
          "$ref": "#/$defs/gitlinkMemories"
        },
        {
          "$ref": "#/$defs/gitlinkParties"
        },
        {
          "$ref": "#/$defs/gitlinkProjects"
        },
        {
          "$ref": "#/$defs/gitlinkTenants"
        }
      ],
      "items": false
    },
    "testCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "executed",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/count"
        },
        "executed": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "skipped": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "measuredProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "projectPath",
        "resultFile",
        "counts"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "$ref": "#/$defs/path"
        },
        "resultFile": {
          "$ref": "#/$defs/outputFile"
        },
        "counts": {
          "$ref": "#/$defs/testCounts"
        }
      }
    },
    "predecessorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storyId",
        "path",
        "sha256"
      ],
      "properties": {
        "storyId": {
          "$ref": "#/$defs/storyId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "uxDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "predecessorRecord",
        "sources",
        "outputs",
        "testAssembly",
        "sourceRevisionId"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/outputFile"
        },
        "predecessorRecord": {
          "$ref": "#/$defs/predecessorRecord"
        },
        "sources": {
          "type": "array",
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/outputFile"
            },
            {
              "$ref": "#/$defs/outputFile"
            }
          ]
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "json",
            "markdown"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/outputFile"
            },
            "json": {
              "$ref": "#/$defs/outputFile"
            },
            "markdown": {
              "$ref": "#/$defs/outputFile"
            }
          }
        },
        "testAssembly": {
          "$ref": "#/$defs/outputFile"
        },
        "sourceRevisionId": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "changedPaths",
        "testProjects",
        "testTotals",
        "predecessorRecord"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/commit"
        },
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "testProjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/measuredProject"
          }
        },
        "testTotals": {
          "$ref": "#/$defs/testCounts"
        },
        "predecessorRecord": {
          "$ref": "#/$defs/predecessorRecord"
        }
      }
    },
    "workflowIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "workflowBodies",
        "predecessorRecords"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/outputFile"
        },
        "workflowBodies": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/outputFile"
          }
        },
        "predecessorRecords": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/predecessorRecord"
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "assertionLedger"
        ]
      },
      "required": [
        "scenarioId",
        "command",
        "exitCode",
        "result",
        "blockers"
      ],
      "properties": {
        "scenarioId": {
          "$ref": "#/$defs/scenarioId"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "$ref": "#/$defs/exitCode"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "blockers": {
          "$ref": "#/$defs/blockers"
        },
        "resultFile": {
          "$ref": "#/$defs/outputFile"
        },
        "outputFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/outputFile"
          }
        },
        "assertionLedger": {
          "$ref": "#/$defs/assertionLedger"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-(?:[7-9]|1[0-6])\\.[1-4]-[0-9]{2}#[0-9]{4}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "state": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "assertionLedger": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedBlocker"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expectedBlocker": {
          "$ref": "#/$defs/blocker"
        }
      }
    },
    "faultInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fault"
          }
        }
      }
    },
    "outputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "markdown"
      ],
      "properties": {
        "json": {
          "$ref": "#/$defs/outputFile"
        },
        "markdown": {
          "$ref": "#/$defs/outputFile"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary"
      ],
      "properties": {
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "passed",
        "failed",
        "blocked",
        "skipped",
        "notRun"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/count"
