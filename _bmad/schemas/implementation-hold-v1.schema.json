{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/implementation-hold-v1.schema.json",
  "title": "Hexalith.Conversations release-owner implementation-hold decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "decisionDate",
    "decisionAuthority",
    "scope",
    "expiry",
    "ir0Assessment",
    "rationale",
    "nonClaims",
    "effectiveState",
    "resultSemantics",
    "result",
    "assertionLedger"
  ],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.implementation-hold.v1" },
    "decisionId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,79}$" },
    "decisionDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decisionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "mechanism"],
      "properties": {
        "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlocks",
        "global",
        "planningCandidate",
        "bundleDigest",
        "ir0Sha256",
        "staleOnDrift"
      ],
      "properties": {
        "unlocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "7.1-SCHEMAS" }
        },
        "global": { "const": false },
        "planningCandidate": { "$ref": "#/$defs/sha1" },
        "bundleDigest": { "$ref": "#/$defs/sha256" },
        "ir0Sha256": { "$ref": "#/$defs/sha256" },
        "staleOnDrift": { "const": true }
      }
    },
    "expiry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "calendarExpiry"],
      "properties": {
        "kind": { "const": "candidate-bound" },
        "calendarExpiry": { "type": "null" }
      }
    },
    "ir0Assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result", "effectiveHoldAtAssessment"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "result": { "const": "READY" },
        "effectiveHoldAtAssessment": { "const": "ACTIVE" }
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "effectiveState": { "const": "LIFTED" },
    "resultSemantics": {
      "const": {
        "states": ["PASS", "FAIL", "BLOCKED", "not-applicable"],
        "ledgerRequired": true,
        "skipsAllowed": false
      }
    },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"] },
    "assertionLedger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^HOLD-[A-Z0-9-]{1,60}$" },
          "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
          "state": { "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"] }
        }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    }
  }
}
