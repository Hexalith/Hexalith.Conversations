      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "state", "detail"],
      "properties": {
        "id": { "type": "string", "pattern": "^V26\\.SUCCESSOR\\.[0-9]{2}$" },
        "subject": { "type": "string", "minLength": 1 },
