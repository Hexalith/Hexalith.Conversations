{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-execution-graph-v1.schema.json",
  "title": "Conversations V9 Execution Graph V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planningCandidate", "authorities", "implementationHold", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.v9-execution-graph.v1" },
    "planningCandidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorities": { "$ref": "#/$defs/authorities" },
    "implementationHold": { "const": "ACTIVE" },
    "nodes": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "prefixItems": [
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "10.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "10.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "10.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "10.4" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "11.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "11.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "11.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "12.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "12.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "12.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "12.4" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "13.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "13.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "13.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "14.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "14.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "14.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "15.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "15.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "16.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "16.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "16.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "6.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "7.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "7.1-SCHEMAS" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "7.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "7.3" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "7.4" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "8.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "8.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "9.1" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "9.2" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "E6-CURRENT-CANDIDATE" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "E6-CURRENT-PROOF" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "E6-REMEDIATION" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "IR-0" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "PC-PUBLICATION" } } },
        { "$ref": "#/$defs/node", "properties": { "id": { "const": "RG-15" } } }
      ],
      "items": false
    },
    "edges": {
      "type": "array",
      "minItems": 61,
      "maxItems": 61,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "predecessors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["historical-story", "publication", "gate", "checkpoint", "story", "release-gate"] },
        "predecessors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture"],
      "properties": {
        "epic": { "const": "epic-6-authority-2026-08-18-v14" },
        "architecture": { "const": "conversations-architecture-2026-08-18-v14" }
      }
    }
  }
}
