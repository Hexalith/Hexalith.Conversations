{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-inventory-v1.schema.json",
  "title": "Conversations V9 Planning Inventory V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "planningCandidate",
    "authorities",
    "inventoryDigest",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.v9-inventory.v1" },
    "inventoryId": { "type": "string", "minLength": 1 },
    "planningCandidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorities": { "$ref": "#/$defs/authorities" },
    "inventoryDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "path", "sha256"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "logicalBody": { "type": "string", "minLength": 1 },
          "tree": { "enum": ["agents", "claude", "project"] }
        }
      }
    }
  },
  "$defs": {
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture"],
      "properties": {
        "epic": { "const": "epic-6-authority-2026-08-04-v12" },
        "architecture": { "const": "conversations-architecture-2026-08-04-v12" }
      }
    }
  }
}
