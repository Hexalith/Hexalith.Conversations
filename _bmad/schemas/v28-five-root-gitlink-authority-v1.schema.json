            {
              "const": "FAIL"
            },
            {
              "const": "BLOCKED"
            }
          ],
          "items": false
        },
        "exitCodes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ],
          "properties": {
            "PASS": {
              "const": 0
            },
            "FAIL": {
              "const": 1
            },
            "BLOCKED": {
              "const": 2
            }
          }
        },
        "ledgerRequired": {
          "const": true
        }
      }
    },
