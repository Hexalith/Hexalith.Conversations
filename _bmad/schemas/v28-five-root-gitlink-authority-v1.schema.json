      "properties": {
        "candidateCommit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "candidateTree": {
          "$ref": "#/$defs/nullableCommit"
        },
        "parentCommit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "parentTree": {
          "$ref": "#/$defs/nullableCommit"
        },
        "changedPaths": {
          "type": "array",
          "items": {
