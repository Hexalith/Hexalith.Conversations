          }
        },
        "parentGitlinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gitlink"
          }
        },
        "candidateGitlinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gitlink"
          }
        }
      }
    },
