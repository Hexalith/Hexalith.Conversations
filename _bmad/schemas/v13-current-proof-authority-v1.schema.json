{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/v13-current-proof-authority-v1.schema.json",
  "title": "V13 current-proof authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "authority",
    "predecessors",
    "successor",
    "actionInventory",
    "rootGitlinkPaths",
    "currentProofContract",
    "resultSemantics",
    "prohibitions",
    "completionEffect",
    "assertions"
  ],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.v13-current-proof-authority.v1" },
    "checkpointId": { "const": "E6-CURRENT-PROOF" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture", "planningCandidate", "authorityBundlePath", "implementationHold"],
      "properties": {
        "epic": { "const": "epic-6-authority-2026-08-04-v12" },
        "architecture": { "const": "conversations-architecture-2026-08-04-v12" },
        "planningCandidate": { "$ref": "#/$defs/sha1" },
        "authorityBundlePath": { "const": "_bmad-output/planning-artifacts/v9-authority-bundle-v1.json" },
        "implementationHold": { "const": "ACTIVE" }
      }
    },
    "predecessors": { "const": ["E6-REMEDIATION"] },
    "successor": { "const": "none" },
    "actionInventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "rootGitlinkPaths": {
      "const": [
        "references/Hexalith.AI.Tools",
        "references/Hexalith.Builds",
        "references/Hexalith.Commons",
        "references/Hexalith.EventStore",
        "references/Hexalith.Folders",
        "references/Hexalith.FrontComposer",
        "references/Hexalith.Memories",
        "references/Hexalith.Parties",
        "references/Hexalith.Projects",
        "references/Hexalith.Tenants"
      ]
    },
    "currentProofContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "_bmad-output/planning-artifacts/epic-6-completion-supersession-current-proof-contract-v1.json"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resultSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "ledgerRequired", "skipsAllowed"],
      "properties": {
        "states": { "const": ["PASS", "FAIL", "BLOCKED", "not-applicable"] },
        "ledgerRequired": { "const": true },
        "skipsAllowed": { "const": false }
      }
    },
    "prohibitions": {
      "const": [
        "rewrite completed Story 6.7 or Story 6.2 records",
        "substitute current bytes for historical evidence",
        "edit V1-V12 historical schema, contract, decision, or evidence",
        "traverse nested submodules",
        "modify product code, packages, submodules, or gitlinks",
        "implement or start successors",
        "create implementation-hold-v1.json",
        "claim release approval",
        "lift the implementation hold",
        "authorize IR-0",
        "silently apply epic-6-retro-item-24 sprint-status transition"
      ]
    },
    "completionEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ir0RerunAllowed",
        "holdLifted",
        "successorStarted",
        "releaseAuthorized",
        "retroItem24TransitionRequiresHuman"
      ],
      "properties": {
        "ir0RerunAllowed": { "const": false },
        "holdLifted": { "const": false },
        "successorStarted": { "const": false },
        "releaseAuthorized": { "const": false },
        "retroItem24TransitionRequiresHuman": { "const": true }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "scope", "executionAuthority", "checkpointOwned", "status"],
      "properties": {
        "id": { "const": "A1" },
        "owner": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "executionAuthority": { "const": "E6-CURRENT-PROOF" },
        "checkpointOwned": { "const": true },
        "status": { "const": "open" }
      }
    }
  }
}
