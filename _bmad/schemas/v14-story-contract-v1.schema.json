{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v14-story-contract-v1.schema.json",
  "title": "Conversations V14 Effective Story Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyId", "authority", "predecessors", "outcome", "rollback", "inventory", "scenarios", "finalRecord"],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.story-contract.v1" },
    "storyId": { "enum": ["12.1", "13.1", "14.1", "15.1", "16.1", "16.2", "16.3"] },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture", "planningCandidate", "candidateBinding", "sectionSha256"],
      "properties": {
        "epic": { "enum": ["epic-6-authority-2026-08-03-v10", "epic-6-authority-2026-08-18-v14"] },
        "architecture": { "enum": ["conversations-architecture-2026-08-03-v10", "conversations-architecture-2026-08-18-v14"] },
        "planningCandidate": { "$ref": "#/$defs/commit" },
        "candidateBinding": { "type": "string", "minLength": 1 },
        "sectionSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "predecessors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:IR-0|6\\.2|(?:[7-9]|1[0-6])\\.[1-4])$" }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "bounded"],
      "properties": { "title": { "type": "string", "minLength": 1 }, "bounded": { "type": "string", "minLength": 1 } }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary"],
      "properties": { "boundary": { "type": "string", "minLength": 1 } }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" } }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "contract", "resultSemantics"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-(?:1[2-6])\\.[1-3]-[0-9]{2}$" },
          "command": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "resultSemantics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected", "passExitCodes", "failExitCodes", "blockedExitCodes", "notApplicableAllowed"],
            "properties": {
              "expected": { "const": "PASS" },
              "passExitCodes": { "$ref": "#/$defs/exitCodes" },
              "failExitCodes": { "$ref": "#/$defs/exitCodes" },
              "blockedExitCodes": { "$ref": "#/$defs/exitCodes" },
              "notApplicableAllowed": { "const": false }
            }
          }
        }
      }
    },
    "finalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "summary"],
      "properties": {
        "paths": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "passed", "failed", "blocked", "skipped", "notRun"],
          "properties": {
            "required": { "type": "integer", "minimum": 1 },
            "passed": { "type": "integer", "minimum": 1 },
            "failed": { "const": 0 },
            "blocked": { "const": 0 },
            "skipped": { "const": 0 },
            "notRun": { "const": 0 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "storyId": { "pattern": "^16\\." } } },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "epic": { "const": "epic-6-authority-2026-08-18-v14" },
              "architecture": { "const": "conversations-architecture-2026-08-18-v14" }
            }
          },
          "scenarios": { "minItems": 6, "maxItems": 6 },
          "finalRecord": { "properties": { "summary": { "properties": { "required": { "const": 6 }, "passed": { "const": 6 } } } } }
        }
      },
      "else": {
        "properties": {
          "authority": {
            "properties": {
              "epic": { "const": "epic-6-authority-2026-08-03-v10" },
              "architecture": { "const": "conversations-architecture-2026-08-03-v10" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "exitCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 5 } }
  }
}
