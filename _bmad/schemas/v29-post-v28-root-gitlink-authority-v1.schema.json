{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v29-post-v28-root-gitlink-authority-v1.schema.json",
  "title": "V29 post-V28 root gitlink authority successor",
  "description": "Closed contracts for the externally authorized V29 bootstrap publication (C1), its deterministic record-only publication (C2), and the route-discriminated non-executable result envelope both protected hosts return.",
  "oneOf": [
    {
      "$ref": "#/$defs/publicationRecord"
    },
    {
      "$ref": "#/$defs/resultEnvelope"
    }
  ],
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullableCommit": {
      "oneOf": [
        {
          "$ref": "#/$defs/commit"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\x00-\\x1F\\x7F])[^/]+(?:/[^/]+)*$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "objectId",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "mode": {
          "const": "100644"
        },
        "objectId": {
          "$ref": "#/$defs/commit"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "objectId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "mode": {
          "const": "160000"
        },
        "objectId": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "changedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "objectId",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "mode": {
          "enum": [
            "000000",
            "100644",
            "100755",
            "120000",
            "160000"
          ]
        },
        "objectId": {
          "$ref": "#/$defs/commit"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "recordAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "state",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^V29\\.SUCCESSOR\\.[0-9]{2}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "PASS"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resultAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "state",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^V29(\\.(ROUTE\\.(C1|C2|DESCENDANT|DRIFT|BLOCKED)|SUCCESSOR\\.[0-9]{2})|_[A-Z0-9_]+)$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^V29_[A-Z0-9_]+$"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
