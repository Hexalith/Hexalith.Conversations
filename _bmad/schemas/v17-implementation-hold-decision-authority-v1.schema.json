{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.com/schemas/v17-implementation-hold-decision-authority-v1.schema.json",
  "title": "Hexalith.Conversations V17 implementation-hold decision authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "predecessorAuthorityId",
    "baselineCommit",
    "candidateCommit",
    "publication",
    "candidateFiles",
    "holdRecord",
    "predecessor",
    "immutableAuthorities",
    "ir0Assessment",
    "authorityEffect",
    "nonClaims",
    "resultSemantics",
    "result",
    "assertionLedger"
  ],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.v17-implementation-hold-decision-authority.v1" },
    "authorityId": { "const": "V17-IMPLEMENTATION-HOLD-DECISION" },
    "predecessorAuthorityId": { "const": "V16-PLANNING-TOOLING-LIFECYCLE" },
    "baselineCommit": { "$ref": "#/$defs/sha1" },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c1Paths", "c2Paths", "combinedPaths", "changedGitlinks"],
      "properties": {
        "c1Paths": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "c2Paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "combinedPaths": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "changedGitlinks": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/repositoryPath" } }
      }
    },
    "candidateFiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fileRow" }
    },
    "holdRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode", "effectiveState"],
      "properties": {
        "path": { "const": "_bmad-output/planning-artifacts/implementation-hold-v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "const": "100644" },
        "effectiveState": { "const": "LIFTED" }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileSha256", "planningCandidate", "bundleDigest"],
      "properties": {
        "path": { "const": "_bmad-output/planning-artifacts/v9-authority-bundle-v1.json" },
        "fileSha256": { "const": "8af7ba3bdbc5efe80c9534463089013d8408b5aa0f291f3c00b3dcd36f953ef3" },
        "planningCandidate": { "const": "1e9a61126d3b7a55b514b7c7c8942d5af03355e5" },
        "bundleDigest": { "const": "159eec0cb13d2af422c46e9490e51432495ea61c0d034832a502c9598ff4f055" }
      }
    },
    "immutableAuthorities": {
      "const": [
        {
          "path": "_bmad-output/planning-artifacts/v9-authority-bundle-v1.json",
          "sha256": "8af7ba3bdbc5efe80c9534463089013d8408b5aa0f291f3c00b3dcd36f953ef3",
          "mode": "100644"
        },
        {
          "path": "_bmad-output/planning-artifacts/v12-pre-ir0-remediation-authority-v1.json",
          "sha256": "c082cde6923e9831eea768be6c547ca1ab87ed91244185b505bdf3ae1c116dcc",
          "mode": "100644"
        },
        {
          "path": "_bmad-output/planning-artifacts/v13-current-proof-authority-v1.json",
          "sha256": "f2f02115502d42d6e74f1e34351eeda1e1d778b35e2dee485821ac53e448138f",
          "mode": "100644"
        },
        {
          "path": "_bmad-output/planning-artifacts/v14-current-candidate-authority-v1.json",
          "sha256": "e96c34dfdf7f2cd8619b75abc42aad40ab0d8606d3ab798bf2b9b58fac83da7f",
          "mode": "100644"
        },
        {
          "path": "_bmad-output/planning-artifacts/v15-planning-tooling-environment-authority-v1.json",
          "sha256": "bac4dc435bc200d2eb5b3601a794b20abe5afaa79dc51b79d4f9571a6f6a37ea",
          "mode": "100644"
        },
        {
          "path": "_bmad-output/planning-artifacts/v16-planning-tooling-lifecycle-authority-v1.json",
          "sha256": "5b71e6fbf8851f790af92f0a0d056d7f7e04b3b9749c3a2f3f4ef5f87312d45a",
          "mode": "100644"
        },
        {
          "path": "_bmad-output/planning-artifacts/implementation-readiness-report-2026-08-22-ir-0.md",
          "sha256": "862a880ca621c4f9b60328bc2f1ce353951d5ae7fcce811cffb6d050e8b122ad",
          "mode": "100644"
        }
      ]
    },
    "ir0Assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result", "effectiveHoldAtAssessment", "preserved"],
      "properties": {
        "path": { "const": "_bmad-output/planning-artifacts/implementation-readiness-report-2026-08-22-ir-0.md" },
        "sha256": { "const": "862a880ca621c4f9b60328bc2f1ce353951d5ae7fcce811cffb6d050e8b122ad" },
        "result": { "const": "READY" },
        "effectiveHoldAtAssessment": { "const": "ACTIVE" },
        "preserved": { "const": true }
      }
    },
    "authorityEffect": {
      "const": {
        "implementationHold": "LIFTED",
        "ir0AuthorizationChanged": false,
        "successorActivated": true,
        "unlocks": ["7.1-SCHEMAS"],
        "storyDoneAllowed": false,
        "readinessRerunSatisfied": false,
        "releaseAuthorized": false,
        "pushAuthorized": false
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "resultSemantics": {
      "const": {
        "states": ["PASS", "FAIL", "BLOCKED", "not-applicable"],
        "ledgerRequired": true,
        "skipsAllowed": false
      }
    },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"] },
    "assertionLedger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^V17-[A-Z0-9-]{1,60}$" },
          "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
          "state": { "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"] },
          "paths": { "type": "array", "items": { "$ref": "#/$defs/repositoryPath" } }
        }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "fileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "const": "100644" }
      }
    }
  }
}
