{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-supersession-map-v1.schema.json",
  "title": "Conversations V9 Supersession Map V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planningCandidate", "authorities", "storyDispositions", "v8AcceptanceObligations"],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.v9-supersession-map.v1" },
    "planningCandidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorities": { "$ref": "#/$defs/authorities" },
    "storyDispositions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceStory", "sourceStatus", "successorEpic", "successorStories", "salvagePolicy"],
        "properties": {
          "sourceStory": { "type": "string", "pattern": "^6\\.(?:3|4|5|6|8|9|10|11|12)$" },
          "sourceStatus": { "enum": ["backlog", "ready-for-dev", "in-progress"] },
          "successorEpic": { "type": "integer", "minimum": 7, "maximum": 15 },
          "successorStories": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
          "salvagePolicy": { "type": "string", "minLength": 1 }
        }
      }
    },
    "v8AcceptanceObligations": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "bindings"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^V8-6\\.(?:3|4|5|6|8|9|10|11|12)-AC[0-9]+$" },
          "bindings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture"],
      "properties": {
        "epic": { "const": "epic-6-authority-2026-08-03-v10" },
        "architecture": { "const": "conversations-architecture-2026-08-03-v10" }
      }
    }
  }
}
