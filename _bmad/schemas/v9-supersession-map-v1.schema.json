{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-supersession-map-v1.schema.json",
  "title": "Conversations V9 Supersession Map V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planningCandidate",
    "authorities",
    "storyDispositions",
    "preservationDenominators",
    "obligationLedger"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hexalith.conversations.v9-supersession-map.v1"
    },
    "planningCandidate": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorities": {
      "$ref": "#/$defs/authorities"
    },
    "storyDispositions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceStory",
          "sourceStatus",
          "successorEpic",
          "successorStories",
          "salvagePolicy"
        ],
        "properties": {
          "sourceStory": {
            "type": "string",
            "pattern": "^6\\.(?:3|4|5|6|8|9|10|11|12)$"
          },
          "sourceStatus": {
            "enum": ["backlog", "ready-for-dev", "in-progress"]
          },
          "successorEpic": {
            "type": "integer",
            "minimum": 7,
            "maximum": 15
          },
          "successorStories": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "salvagePolicy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preservationDenominators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionalRequirements",
        "nonFunctionalRequirements",
        "uxDecisions",
        "uxAcceptanceCriteria"
      ],
      "properties": {
        "functionalRequirements": { "$ref": "#/$defs/denominator124" },
        "nonFunctionalRequirements": { "$ref": "#/$defs/denominator77" },
        "uxDecisions": { "$ref": "#/$defs/denominator52" },
        "uxAcceptanceCriteria": { "$ref": "#/$defs/denominator28" }
      }
    },
    "obligationLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryId",
        "sha256",
        "acceptanceCriteriaRows",
        "totalRows",
        "rows"
      ],
      "properties": {
        "inventoryId": {
          "const": "V9-V8-OBLIGATION-LEDGER-v1"
        },
        "sha256": {
          "const": "4dbffda456c4f40055985f303ed9d10d8e7839573e2486c4d01ca5508dca8f87"
        },
        "acceptanceCriteriaRows": { "const": 66 },
        "totalRows": { "const": 156 },
        "rows": {
          "type": "array",
          "minItems": 156,
          "maxItems": 156,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "table",
              "sourceId",
              "canonicalBinding",
              "effectiveBindings"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 156
              },
              "table": {
                "enum": ["acceptance-criteria", "supporting-obligations"]
              },
              "sourceId": {
                "type": "string",
                "pattern": "^V8-[A-Z0-9.-]+$"
              },
              "canonicalBinding": {
                "type": "string",
                "minLength": 1
              },
              "effectiveBindings": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "architecture"],
      "properties": {
        "epic": { "const": "epic-6-authority-2026-08-03-v10" },
        "architecture": { "const": "conversations-architecture-2026-08-03-v10" }
      }
    },
    "denominator124": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mapped"],
      "properties": {
        "required": { "const": 124 },
        "mapped": { "const": 124 }
      }
    },
    "denominator77": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mapped"],
      "properties": {
        "required": { "const": 77 },
        "mapped": { "const": 77 }
      }
    },
    "denominator52": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mapped"],
      "properties": {
        "required": { "const": 52 },
        "mapped": { "const": 52 }
      }
    },
    "denominator28": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mapped"],
      "properties": {
        "required": { "const": 28 },
        "mapped": { "const": 28 }
      }
    }
  }
}
