{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-acceptance-result-v1.schema.json",
  "title": "Conversations Acceptance Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyId",
    "scenarioId",
    "command",
    "exitCode",
    "result",
    "blockers",
    "candidate",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hexalith.conversations.acceptance-result.v1"
    },
    "storyId": {
      "$ref": "#/$defs/storyId"
    },
    "scenarioId": {
      "$ref": "#/$defs/scenarioId"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "$ref": "#/$defs/exitCode"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "blockers": {
      "$ref": "#/$defs/blockers"
    },
    "candidate": {
      "$ref": "#/$defs/commit"
    },
    "inputs": {
      "$ref": "#/$defs/digestBindings"
    },
    "outputs": {
      "$ref": "#/$defs/digestBindings"
    },
    "assertionLedger": {
      "$ref": "#/$defs/assertionLedger"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "storyId": {
      "type": "string",
      "pattern": "^(?:[7-9]|1[0-6])\\.[1-4]$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^AC-(?:[7-9]|1[0-6])\\.[1-4]-[0-9]{2}$"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "result": {
      "enum": ["PASS", "FAIL", "BLOCKED", "not-applicable"]
    },
    "blocker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "digestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digestBindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digestBinding"
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "assertionLedger": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  }
}
