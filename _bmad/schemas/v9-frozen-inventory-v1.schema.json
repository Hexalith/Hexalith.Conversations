{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/v9-frozen-inventory-v1.schema.json",
  "title": "Conversations Frozen Inventory V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "digestAlgorithm",
    "canonicalization",
    "items",
    "sha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hexalith.conversations.frozen-inventory.v1"
    },
    "inventoryId": {
      "type": "string",
      "minLength": 1
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "nfc-utf8-lf-displayed-ids"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
