# Preserve intentional CommonMark hard breaks in the signed release-owner summary.
docs/release-evidence/success-metric-report-and-attestation-v1-release-owner-decision.md whitespace=-blank-at-eol

# Planning authority and signed release evidence are hashed and parsed byte-for-byte by the conformance
# gate (frozen epic prefix, signed v1 manifest, append-only overlay boundary). Without an explicit eol
# policy, a clone with core.autocrlf=true checks these out as CRLF and every hash and boundary assertion
# fails for a reason unrelated to planning authority -- CRLF would be reported as evidence tampering.
# Scoped deliberately by extension: the repository's shared agent entry points are intentionally CRLF and
# are excluded, and a directory-wide rule would force text conversion on binary evidence screenshots,
# corrupting PNG bytes that happen to contain CRLF sequences.
_bmad-output/**/*.md text eol=lf
_bmad-output/**/*.json text eol=lf
_bmad-output/**/*.yaml text eol=lf
_bmad-output/**/*.yml text eol=lf
docs/release-evidence/**/*.md text eol=lf
docs/release-evidence/**/*.json text eol=lf
tests/Hexalith.Conversations.TestSupport/Hexalith.Conversations.TestSupport.csproj text eol=lf
tests/Hexalith.Conversations.TestSupport.Tests/Hexalith.Conversations.TestSupport.Tests.csproj text eol=lf

# Completion-gate body bytes must match the committed blobs and in-memory render twins.
.agents/skills/bmad-build/step-05-present.md text eol=lf
.agents/skills/bmad-build/step-oneshot.md text eol=lf
.agents/skills/bmad-build-auto/step-04-review.md text eol=lf
.agents/skills/bmad-code-review/steps/step-04-present.md text eol=lf
.claude/skills/bmad-build/step-05-present.md text eol=lf
.claude/skills/bmad-build/step-oneshot.md text eol=lf
.claude/skills/bmad-build-auto/step-04-review.md text eol=lf
.claude/skills/bmad-code-review/steps/step-04-present.md text eol=lf

# Never line-ending-convert binary evidence.
*.png binary
*.jpg binary
*.pdf binary
*.zip binary

# Retain the original Story 9.1 machine-result bytes used by the Story 9.2 floor.
docs/release-evidence/conformance-oracle-pre-split-story-9.2.trx -text whitespace=-blank-at-eol

# Bind the new review gates and retained Story 10.3 receipt bytes across checkouts.
.agents/skills/bmad-build/step-04-review.md text eol=lf
.claude/skills/bmad-build/step-04-review.md text eol=lf
artifacts/v9/10.3/*.json text eol=lf
artifacts/v9/10.3/*.xml text eol=lf
tests/Hexalith.Conversations.TestSupport.Runner/Hexalith.Conversations.TestSupport.Runner.csproj text eol=lf
# The pinned C# consumer is authored with the required CRLF convention.
tests/Hexalith.Conversations.TestSupport.Runner/Program.cs -text diff

