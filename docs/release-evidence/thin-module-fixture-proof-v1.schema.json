        "contractPath": {
          "const": "_bmad-output/planning-artifacts/v9/story-contracts/11.2.json"
        },
        "contractSha256": {
          "$ref": "#/$defs/digest"
        },
        "planningCandidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "guidanceDigest": {
