{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hexalith.conversations.thin-module-fixture-proof.v1",
  "title": "Thin-module fixture proof v1",
  "description": "Story 11.2 (Checkpoint B) proof that the frozen minimal-module fixture restores, builds and passes tests against public platform APIs.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\\\s][^\\\\]*$"
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "guidanceDigest",
    "fixtureInventory",
    "resolvedPublicApis",
    "restore",
    "build",
    "tests",
    "appHost",
    "digests"
