{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hexalith.conversations.thin-authoring-guidance.v2",
  "title": "Thin-module authoring guidance bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "source",
    "moduleOwned",
    "platformOwned",
    "prohibited",
    "testAppHost",
    "validation",
    "reviewDecision",
    "digests"
  ],
  "properties": {
    "schemaVersion": { "const": "hexalith.conversations.thin-authoring-guidance.v2" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyId", "contractPath", "contractSha256", "planningCandidate"],
      "properties": {
        "storyId": { "const": "11.1" },
        "contractPath": { "type": "string", "minLength": 1 },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "planningCandidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "docs/domain-module-authoring-template.md" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "moduleOwned": { "$ref": "#/$defs/ownershipList", "minItems": 4, "maxItems": 4 },
    "platformOwned": { "$ref": "#/$defs/ownershipList", "minItems": 7, "maxItems": 7 },
    "prohibited": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prohibition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prohibition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testAppHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "isPackable", "isPublishable", "repositoryOnly", "countedInAuthoringCost"],
      "properties": {
        "count": { "const": 1 },
        "isPackable": { "const": false },
        "isPublishable": { "const": false },
        "repositoryOnly": { "const": true },
        "countedInAuthoringCost": { "const": true }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "authoritySubstitution"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "result"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "result": { "const": "PASS" }
            }
          }
        },
        "authoritySubstitution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptanceCriterion", "decision", "reason", "currentPolicyChecks", "predecessors"],
          "properties": {
            "acceptanceCriterion": { "const": "AC-11.1-01" },
            "decision": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "currentPolicyChecks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "predecessors": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["storyId", "path", "sha256", "binding"],
                "properties": {
                  "storyId": { "enum": ["6.2", "7.4", "10.4"] },
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "binding": { "enum": ["final-record-v2", "release-evidence"] }
                }
              }
            }
          }
        }
      }
    },
    "reviewDecision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "reviewer", "decidedAtUtc", "boundSourceSha256", "boundSignablePayloadSha256"],
          "properties": {
            "decision": { "const": "approved" },
            "reviewer": { "type": "string", "minLength": 1 },
            "decidedAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
            "boundSourceSha256": { "$ref": "#/$defs/sha256" },
            "boundSignablePayloadSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256", "signablePayloadSha256", "markdownSha256"],
      "properties": {
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "signablePayloadSha256": { "$ref": "#/$defs/sha256" },
        "markdownSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ownershipList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
