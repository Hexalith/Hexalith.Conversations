              "$ref": "#/$defs/predecessor",
              "properties": {
                "id": {
                  "const": "story-6.2-record"
                }
              }
            },
            {
              "$ref": "#/$defs/predecessor",
              "properties": {
                "id": {
                  "const": "sm-c2-hot-path-baseline-v1-json"
                }
              }
            },
            {
              "$ref": "#/$defs/predecessor",
              "properties": {
                "id": {
                  "const": "sm-c2-hot-path-baseline-v1-md"
                }
              }
            },
            {
              "$ref": "#/$defs/predecessor",
              "properties": {
                "id": {
                  "const": "sm-c2-hot-path-baseline-v1-xunit"
                }
              }
            },
            {
              "$ref": "#/$defs/predecessor",
              "properties": {
                "id": {
                  "const": "story-16.3-spec"
                }
              }
            }
          ]
        },
        "waivedScenarios": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state",
              "decision"
            ],
            "properties": {
              "id": {
                "enum": [
                  "AC-12.1-01",
                  "AC-12.1-06"
                ]
              },
              "state": {
                "const": "waived"
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "approver",
        "decidedAtUtc",
        "boundAdrSha256",
        "boundSignablePayloadSha256"
      ],
      "properties": {
        "decision": {
          "const": "approved"
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "decidedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "boundAdrSha256": {
          "$ref": "#/$defs/sha256"
        },
        "boundSignablePayloadSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "storyId",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "story-6.2-record",
            "sm-c2-hot-path-baseline-v1-json",
            "sm-c2-hot-path-baseline-v1-md",
            "sm-c2-hot-path-baseline-v1-xunit",
            "story-16.3-spec"
          ]
        },
        "storyId": {
          "enum": [
            "6.2",
            "16.3"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidateCommit": {
          "$ref": "#/$defs/commit"
        }
      }
    }
  }
}
