{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hexalith Conversations Derived-Key Correctness Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "adrAndMethod",
    "productionPathInventory",
    "publicContract",
    "lanes",
    "mutationLedger",
    "replayAndRollback",
    "digests"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "hexalith.conversations.derived-key-correctness-proof.v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storyId",
        "contract",
        "headCommit",
        "rootSubmodules",
        "inventory",
        "predecessors",
        "commandSubstitutions",
        "waivedScenarios"
      ],
      "properties": {
        "storyId": {
          "type": "string",
          "const": "12.3"
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "const": "_bmad-output/planning-artifacts/v9/story-contracts/12.3.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "headCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "rootSubmodules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "gitlink", "url"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "gitlink": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "url": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rows", "sha256"],
          "properties": {
            "id": { "type": "string", "const": "V9-12.3-ENTRY-v1" },
            "rows": {
              "type": "array",
              "const": [
                "V8-6.11-AC2",
                "V8-6.11-AC3",
                "V8-6.11-AC4",
                "V8-6.11-AC8",
                "V8-6.11-PROHIBITION-READS-NEVER-REPAIR-DURABLE-STATE",
                "V8-6.11-ROLLBACK-CORRECTNESS-PRESERVING"
              ],
              "items": { "type": "string" }
            },
            "sha256": {
              "type": "string",
              "const": "90b74a649cd827494f199bb722c3e1708306cc212f5a12df7325218dc4c31546"
            }
          }
        },
        "predecessors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storyId", "commit", "freezeCommit", "files", "sprint"],
            "properties": {
              "storyId": { "type": "string", "enum": ["12.1", "12.2"] },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "freezeCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
              "files": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                  }
                }
              },
              "sprint": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "key", "state", "committedSha256"],
                "properties": {
                  "path": { "type": "string", "const": "_bmad-output/implementation-artifacts/sprint-status.yaml" },
                  "key": { "type": "string", "minLength": 1 },
                  "state": { "type": "string", "const": "done" },
                  "committedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          }
        },
        "commandSubstitutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenarioId", "contracted", "executed", "reason"],
            "properties": {
              "scenarioId": { "type": "string", "minLength": 1 },
              "contracted": { "type": "string", "minLength": 1 },
              "executed": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "waivedScenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state", "decision"],
            "properties": {
              "id": { "type": "string", "const": "AC-12.3-08" },
              "state": { "type": "string", "const": "waived" },
              "decision": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "adrAndMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adrPath",
        "adrSha256",
        "decisionPath",
        "decisionSha256",
        "decisionSignablePayloadSha256",
        "methodPath",
        "methodSha256",
        "methodSignablePayloadSha256",
        "frozenBenchmarkPath",
        "frozenBenchmarkSha256",
        "noSmC2VerdictIssued"
      ],
      "properties": {
        "adrPath": { "type": "string", "const": "docs/adrs/0005-conversation-derived-key-lifecycle.md" },
        "adrSha256": { "type": "string", "const": "2c946907e438850b643f17db704e702c71ece3b7a2826c113b1251df5a0cf068" },
        "decisionPath": { "type": "string", "const": "docs/release-evidence/derived-key-lifecycle-decision-v1.json" },
        "decisionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "decisionSignablePayloadSha256": { "type": "string", "const": "13943cc3b30e3183af09ba5549b0984a4d7170db2e2929c1b85658c22514bbbe" },
        "methodPath": { "type": "string", "const": "docs/release-evidence/sm-c2-measurement-method-v2.json" },
        "methodSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "methodSignablePayloadSha256": { "type": "string", "const": "7d6b2d7a6049a80eda5a578ddf097fa5a0eb0a910327dc9227791f2080174bff" },
        "frozenBenchmarkPath": { "type": "string", "const": "tests/Hexalith.Conversations.IntegrationTests/Performance/SmC2HotPathBenchmark.cs" },
        "frozenBenchmarkSha256": { "type": "string", "const": "f02c4b5d103c591656d4d78181269ef3981e9af6f757200632d13a4038697eff" },
        "noSmC2VerdictIssued": { "type": "boolean", "const": true }
      }
    },
    "productionPathInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publicContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotPath", "snapshotSha256", "frozenSnapshots", "driftDetected"],
      "properties": {
        "snapshotPath": { "type": "string", "const": "docs/release-evidence/public-contract-shape-bounded-read-v4.json" },
        "snapshotSha256": { "type": "string", "const": "4de710b386ff63a2316c603e40556bc78b0f61bbf1635a419cf0d436a1353d74" },
        "frozenSnapshots": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "driftDetected": { "type": "boolean", "const": false }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "integration", "dapr"],
      "properties": {
        "unit": { "$ref": "#/$defs/laneResult" },
        "integration": { "$ref": "#/$defs/laneResult" },
        "dapr": { "$ref": "#/$defs/laneResult" }
      }
    },
    "mutationLedger": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "blockerCode", "category", "enforcedBy"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "blockerCode": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "enforcedBy": { "type": "string", "minLength": 1 }
        }
      }
    },
    "replayAndRollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayDeterminismVerified",
        "rollbackStrategy",
        "reverseWriteAllowed",
        "readRepairAllowed",
        "storyRollbackBoundary"
      ],
      "properties": {
        "replayDeterminismVerified": { "type": "boolean", "const": true },
        "rollbackStrategy": { "type": "string", "const": "redeploy-then-rebuild" },
        "reverseWriteAllowed": { "type": "boolean", "const": false },
        "readRepairAllowed": { "type": "boolean", "const": false },
        "storyRollbackBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadSha256", "markdownSha256"],
      "properties": {
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "markdownSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "laneResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "path",
        "sha256",
        "boundCommit",
        "serverAssemblySha256",
        "testAssemblySha256",
        "total",
        "passed",
        "failed",
        "skipped",
        "notRun",
        "outcome"
      ],
      "properties": {
        "lane": { "type": "string", "enum": ["unit", "integration", "dapr"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "boundCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "serverAssemblySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "testAssemblySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 1 },
        "failed": { "type": "integer", "const": 0 },
        "skipped": { "type": "integer", "const": 0 },
        "notRun": { "type": "integer", "const": 0 },
        "outcome": { "type": "string", "const": "PASS" }
      }
    }
  }
}
