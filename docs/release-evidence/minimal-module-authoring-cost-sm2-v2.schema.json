{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.io/schemas/conversations/minimal-module-authoring-cost-sm2-v2.schema.json",
  "title": "Measured SM-2 v2 Checkpoint C evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "provenance",
    "historicalBaseline",
    "measurement",
    "comparison",
    "singleFileSensitivity",
    "toolVersions",
    "command",
    "digests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hexalith.conversations.minimal-module-authoring-cost-sm2.v2"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storyId",
        "checkpoint",
        "commit",
        "planningCandidate",
        "contractPath",
        "contractSha256",
        "checkpoints",
        "gitlinks"
      ],
      "properties": {
        "storyId": {
          "const": "11.3"
        },
        "checkpoint": {
          "const": "C"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "planningCandidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contractPath": {
          "const": "_bmad-output/planning-artifacts/v9/story-contracts/11.3.json"
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C"
          ],
          "properties": {
            "A": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "B": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "C": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "gitlinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mode",
              "commit"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "const": "160000"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "historicalBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerDecision",
        "sm1BaselineLoc",
        "history"
      ],
      "properties": {
        "ownerDecision": {
          "type": "string",
          "minLength": 1
        },
        "sm1BaselineLoc": {
          "const": 13289
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "inventoryId",
        "inventorySha256",
        "paths",
        "fileCount",
        "physicalLoc",
        "nonblankLoc",
        "confidence",
        "physicalLocMetric",
        "nonblankLocMetric",
        "exclusions",
        "excludedFiles"
      ],
      "properties": {
        "root": {
          "const": "tests/fixtures/Hexalith.Conversations.MinimalModule"
        },
        "inventoryId": {
          "const": "V9-MINIMAL-MODULE-FIXTURE-v1"
        },
        "inventorySha256": {
          "const": "4fa26d6fa11a365339d9ea39c79e38751340847cf963fe71a82c37062f7df15c"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "physicalLoc",
              "nonblankLoc",
              "category",
              "included",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "physicalLoc": {
                "type": "integer",
                "minimum": 0
              },
              "nonblankLoc": {
                "type": "integer",
                "minimum": 0
              },
              "category": {
                "enum": [
                  "AppHost",
                  "Contracts",
                  "domain and registration",
                  "module tests",
                  "repository configuration and documentation"
                ]
              },
              "included": {
                "const": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true
        },
        "fileCount": {
          "const": 13
        },
        "physicalLoc": {
          "type": "integer",
          "minimum": 0
        },
        "nonblankLoc": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "const": "high"
        },
        "physicalLocMetric": {
          "type": "string",
          "minLength": 1
        },
        "nonblankLocMetric": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "reason"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "excludedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceFileCount",
        "referenceLoc",
        "referenceMeasurementType",
        "referenceConfidence",
        "measurementConfidence",
        "comparisonConfidence",
        "decisiveDimension",
        "supportingDimension",
        "thresholdPercentage",
        "comparisonOperator",
        "evaluatedBeforeRounding",
        "fileReductionPercentage",
        "locReductionPercentage",
        "oq2Decision",
        "result",
        "limitations"
      ],
      "properties": {
        "referenceFileCount": {
          "const": 58
        },
        "referenceLoc": {
          "const": 1460
        },
        "referenceMeasurementType": {
          "const": "estimated"
        },
        "referenceConfidence": {
          "const": "low"
        },
        "measurementConfidence": {
          "const": "high"
        },
        "comparisonConfidence": {
          "const": "low"
        },
        "decisiveDimension": {
          "type": "string",
          "minLength": 1
        },
        "supportingDimension": {
          "type": "string",
          "minLength": 1
        },
        "thresholdPercentage": {
          "const": "50.00"
        },
        "comparisonOperator": {
          "const": ">="
        },
        "evaluatedBeforeRounding": {
          "const": true
        },
        "fileReductionPercentage": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "locReductionPercentage": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "oq2Decision": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "result": {
          "enum": [
            "met-on-accepted-estimate",
            "not-met-on-accepted-estimate"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "singleFileSensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumFilesMeetingTarget",
        "additionalFilesBeforeFailure",
        "filesAfterAddingOne",
        "filesAfterRemovingOne",
        "addingOneFlipsAttainment",
        "removingOneFlipsAttainment",
        "singleFileDecisionsThatFlip",
        "explanation"
      ],
      "properties": {
        "maximumFilesMeetingTarget": {
          "const": 29
        },
        "additionalFilesBeforeFailure": {
          "type": "integer",
          "minimum": 0
        },
        "filesAfterAddingOne": {
          "type": "integer",
          "minimum": 0
        },
        "filesAfterRemovingOne": {
          "type": "integer",
          "minimum": 0
        },
        "addingOneFlipsAttainment": {
          "type": "boolean"
        },
        "removingOneFlipsAttainment": {
          "type": "boolean"
        },
        "singleFileDecisionsThatFlip": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "jsonschema",
        "dotnetSdk",
        "git"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "jsonschema": {
          "type": "string",
          "minLength": 1
        },
        "dotnetSdk": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signablePayloadSha256",
        "markdownSha256"
      ],
      "properties": {
        "signablePayloadSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "markdownSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
