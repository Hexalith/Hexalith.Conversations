{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "storyId",
        "purpose",
        "predecessor",
        "preservedContract",
        "authority",
        "nativeProtocol",
        "commands"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hexalith.conversations.epic16-tooling-contract.v1"
        },
        "storyId": {
          "enum": [
            "16.1",
            "16.2",
            "16.3"
          ]
        },
        "purpose": {
          "const": "prerequisite-tooling-only"
        },
        "predecessor": {
          "type": "string"
        },
        "preservedContract": {
          "type": "object"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementationHold",
            "executionAllowed",
            "ownerApprovalClaimed",
            "releaseAuthorized",
            "pushAuthorized"
          ],
          "properties": {
            "implementationHold": {
              "const": "ACTIVE"
            },
            "executionAllowed": {
              "const": false
            },
            "ownerApprovalClaimed": {
              "const": false
            },
            "releaseAuthorized": {
              "const": false
            },
            "pushAuthorized": {
              "const": false
            }
          }
        },
        "nativeProtocol": {
          "type": "object"
        },
        "commands": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "storyId",
        "scenarioId",
        "validationScope",
        "runtimeQualified",
        "authority",
        "result",
        "exitCode",
        "candidate",
        "bindings",
        "counts",
        "assertionLedger",
        "blockers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hexalith.conversations.epic16-measured-result.v1"
        },
        "storyId": {
          "enum": [
            "16.1",
            "16.2",
            "16.3"
          ]
        },
        "scenarioId": {
          "type": "string"
        },
        "validationScope": {
          "enum": [
            "runtime",
            "tooling-fixture"
          ]
        },
        "runtimeQualified": {
          "type": "boolean"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementationHold",
            "executionAllowed",
            "ownerApprovalClaimed",
            "releaseAuthorized",
            "pushAuthorized"
          ],
          "properties": {
            "implementationHold": {
              "const": "ACTIVE"
            },
            "executionAllowed": {
              "const": false
            },
            "ownerApprovalClaimed": {
              "const": false
            },
            "releaseAuthorized": {
              "const": false
            },
            "pushAuthorized": {
              "const": false
            }
          }
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "exitCode": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "candidate": {
          "type": [
            "object",
            "null"
          ]
        },
        "bindings": {
          "type": "object"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "passed",
            "failed",
            "skipped"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        "assertionLedger": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "subject",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED"
                ]
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "exitCode": {
                "const": 0,
                "type": "integer"
              },
              "blockers": {
                "maxItems": 0
              },
              "candidate": {
                "type": "object"
              },
              "scenarioId": {
                "type": "string",
                "pattern": "^AC-16\\.[123]-0[1-6]$"
              }
            }
          },
          "else": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "validationScope": {
                "const": "tooling-fixture"
              }
            }
          },
          "then": {
            "properties": {
              "runtimeQualified": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "storyId",
        "result",
        "validationScope",
        "runtimeQualified",
        "authority",
        "candidate",
        "contract",
        "schema",
        "predecessors",
        "scenarios",
        "receipts",
        "rollback",
        "outputs",
        "summary",
        "digests",
        "retainedNativeArtifacts"
      ],
      "properties": {
        "storyId": {
          "type": "string"
        },
        "validationScope": {
          "type": "string"
        },
        "runtimeQualified": {
          "type": "boolean"
        },
        "candidate": {
          "type": "object"
        },
        "contract": {
          "type": "object"
        },
        "schema": {
          "type": "object"
        },
        "predecessors": {
          "type": "array"
        },
        "scenarios": {
          "type": "array"
        },
        "receipts": {
          "type": "array"
        },
        "rollback": {
          "type": "object"
        },
        "outputs": {
          "type": "array"
        },
        "summary": {
          "type": "object"
        },
        "digests": {
          "type": "object"
        },
        "schemaVersion": {
          "const": "hexalith.conversations.epic16-final-record.v1"
        },
        "result": {
          "const": "PASS"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementationHold",
            "executionAllowed",
            "ownerApprovalClaimed",
            "releaseAuthorized",
            "pushAuthorized"
          ],
          "properties": {
            "implementationHold": {
              "const": "ACTIVE"
            },
            "executionAllowed": {
              "const": false
            },
            "ownerApprovalClaimed": {
              "const": false
            },
            "releaseAuthorized": {
              "const": false
            },
            "pushAuthorized": {
              "const": false
            }
          }
        },
        "retainedNativeArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "AC-16.1-01": {
      "type": "object",
      "required": [
        "authorization",
        "transitions",
        "storeOwner",
        "transitionOwner",
        "consumerOwner",
        "tenantKeys",
        "isolation"
      ],
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "state",
              "allowed",
              "lastContiguousSequence",
              "capture"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1
              },
              "allowed": {
                "type": "boolean"
              },
              "lastContiguousSequence": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capture": {
                "type": "object",
                "required": [
                  "captureVersion",
                  "control",
                  "scope",
                  "observedAtUtcTicks",
                  "sourceState",
                  "sourceRecord",
                  "conflict",
                  "writes",
                  "recoveryOperations",
                  "request",
                  "storeRead",
                  "response"
                ],
                "additionalProperties": false,
                "properties": {
                  "captureVersion": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "control": {
                    "type": "object",
                    "required": [
                      "id",
                      "maxAgeTicks"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "maxAgeTicks": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      }
                    }
                  },
                  "scope": {
                    "type": "object",
                    "required": [
                      "tenant",
                      "storeId",
                      "recordId",
                      "processId",
                      "requestId",
                      "principal"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "tenant": {
                        "type": "string"
                      },
                      "storeId": {
                        "type": "string"
                      },
                      "recordId": {
                        "type": "string"
                      },
                      "processId": {
                        "type": "string"
                      },
                      "requestId": {
                        "type": "string"
                      },
                      "principal": {
                        "type": "string"
                      }
                    }
                  },
                  "observedAtUtcTicks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "sourceState": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "tenantId",
                          "name",
                          "description",
                          "status",
                          "members",
                          "configuration"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "tenantId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "status": {
                            "type": "string"
                          },
                          "members": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string",
                              "enum": [
                                "Unknown",
                                "TenantOwner",
                                "TenantContributor",
                                "TenantReader"
                              ]
                            }
                          },
                          "configuration": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceRecord": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "sequence",
                          "messageId",
                          "eventType",
                          "persistedPayload",
                          "payloadSha256"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "sequence": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "messageId": {
                            "type": "string"
                          },
                          "eventType": {
                            "type": "string"
                          },
                          "persistedPayload": {
                            "type": "string"
                          },
                          "payloadSha256": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "conflict": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "sequence",
                          "messageId",
                          "eventType",
                          "persistedPayload",
                          "payloadSha256"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "sequence": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "messageId": {
                            "type": "string"
                          },
                          "eventType": {
                            "type": "string"
                          },
                          "persistedPayload": {
                            "type": "string"
                          },
                          "payloadSha256": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "writes": {
                    "type": "array",
                    "maxItems": 0,
                    "items": false
                  },
                  "recoveryOperations": {
                    "type": "array",
                    "maxItems": 0,
                    "items": false
                  },
                  "request": {
                    "type": "object",
                    "required": [
                      "operationId",
                      "scope",
                      "executed",
                      "completed",
                      "order",
                      "completedOrder",
                      "method",
                      "requirement"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "operationId": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "object",
                        "required": [
                          "tenant",
                          "storeId",
                          "recordId",
                          "processId",
                          "requestId",
                          "principal"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "tenant": {
                            "type": "string"
                          },
                          "storeId": {
                            "type": "string"
                          },
                          "recordId": {
                            "type": "string"
                          },
                          "processId": {
                            "type": "string"
                          },
                          "requestId": {
                            "type": "string"
                          },
                          "principal": {
                            "type": "string"
                          }
                        }
                      },
                      "executed": {
                        "type": "boolean"
                      },
                      "completed": {
                        "type": "boolean"
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "completedOrder": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "method": {
                        "type": "string"
                      },
                      "requirement": {
                        "type": "string"
                      }
                    }
                  },
                  "storeRead": {
                    "type": "object",
                    "required": [
                      "operationId",
                      "scope",
                      "executed",
                      "completed",
                      "order",
                      "completedOrder",
                      "method",
                      "logicalKey",
                      "outcome",
                      "error",
                      "snapshot"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "operationId": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "object",
                        "required": [
                          "tenant",
                          "storeId",
                          "recordId",
                          "processId",
                          "requestId",
                          "principal"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "tenant": {
                            "type": "string"
                          },
                          "storeId": {
                            "type": "string"
                          },
                          "recordId": {
                            "type": "string"
                          },
                          "processId": {
                            "type": "string"
                          },
                          "requestId": {
                            "type": "string"
                          },
                          "principal": {
                            "type": "string"
                          }
                        }
                      },
                      "executed": {
                        "type": "boolean"
                      },
                      "completed": {
                        "type": "boolean"
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "completedOrder": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "method": {
                        "type": "string"
                      },
                      "logicalKey": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string"
                      },
                      "error": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "snapshot": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "tenant",
                              "checkpoint",
                              "projection",
                              "lastAccepted",
                              "health",
                              "pending",
                              "horizon",
                              "etag",
                              "freshness"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "tenant": {
                                "type": "string"
                              },
                              "checkpoint": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9223372036854775807
                              },
                              "projection": {
                                "type": "object",
                                "required": [
                                  "tenantId",
                                  "name",
                                  "description",
                                  "status",
                                  "members",
                                  "configuration"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "tenantId": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "description": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "status": {
                                    "type": "string"
                                  },
                                  "members": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "type": "string",
                                      "enum": [
                                        "Unknown",
                                        "TenantOwner",
                                        "TenantContributor",
                                        "TenantReader"
                                      ]
                                    }
                                  },
                                  "configuration": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "lastAccepted": {
                                "type": "object",
                                "required": [
                                  "sequence",
                                  "messageId",
                                  "eventType",
                                  "payloadSha256"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "sequence": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9223372036854775807
                                  },
                                  "messageId": {
                                    "type": "string"
                                  },
                                  "eventType": {
                                    "type": "string"
                                  },
                                  "payloadSha256": {
                                    "type": "string"
                                  }
                                }
                              },
                              "health": {
                                "type": "string"
                              },
                              "pending": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "required": [
                                    "sequence",
                                    "messageId",
                                    "eventType",
                                    "persistedPayload",
                                    "payloadSha256"
                                  ],
                                  "additionalProperties": false,
                                  "properties": {
                                    "sequence": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9223372036854775807
                                    },
                                    "messageId": {
                                      "type": "string"
                                    },
                                    "eventType": {
                                      "type": "string"
                                    },
                                    "persistedPayload": {
                                      "type": "string"
                                    },
                                    "payloadSha256": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "horizon": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9223372036854775807
                              },
                              "etag": {
                                "type": "string"
                              },
                              "freshness": {
                                "type": "object",
                                "required": [
                                  "lastAppliedUtcTicks",
                                  "generatedUtcTicks",
                                  "lagTicks"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "lastAppliedUtcTicks": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9223372036854775807
                                  },
                                  "generatedUtcTicks": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9223372036854775807
                                  },
                                  "lagTicks": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9223372036854775807
                                  }
                                }
                              }
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "response": {
                    "type": "object",
                    "required": [
                      "operationId",
                      "scope",
                      "executed",
                      "completed",
                      "order",
                      "completedOrder",
                      "observedReadId",
                      "decision"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "operationId": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "object",
                        "required": [
                          "tenant",
                          "storeId",
                          "recordId",
                          "processId",
                          "requestId",
                          "principal"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "tenant": {
                            "type": "string"
                          },
                          "storeId": {
                            "type": "string"
                          },
                          "recordId": {
                            "type": "string"
                          },
                          "processId": {
                            "type": "string"
                          },
                          "requestId": {
                            "type": "string"
                          },
                          "principal": {
                            "type": "string"
                          }
                        }
                      },
                      "executed": {
                        "type": "boolean"
                      },
                      "completed": {
                        "type": "boolean"
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "completedOrder": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "observedReadId": {
                        "type": "string"
                      },
                      "decision": {
                        "type": "object",
                        "required": [
                          "isAllowed",
                          "requirement",
                          "tenantId",
                          "callerPrincipalId",
                          "denialReason",
                          "isRetryable",
                          "projectionVersion",
                          "projectionWatermark"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "isAllowed": {
                            "type": "boolean"
                          },
                          "requirement": {
                            "type": "string"
                          },
                          "tenantId": {
                            "type": "string"
                          },
