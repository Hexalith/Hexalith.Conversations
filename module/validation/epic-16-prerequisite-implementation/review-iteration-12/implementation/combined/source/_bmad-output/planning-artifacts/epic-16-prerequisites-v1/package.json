  "pendingDecisions": [
    {
      "id": "operational-provider-and-scope",
      "owner": "Hexalith.Platform with Conversations owner",
      "state": "pending",
      "question": "Qualify Conversations Platform enrollment, injected readmodel/checkpoint stores and Tenants subscription scopes; infrastructure selection is resolved in favor of Hexalith.Platform."
    },
    {
      "id": "environment-versions-and-parity",
      "owner": "Hexalith.Platform with Quality",
      "state": "pending",
      "question": "Bind the exact accepted Platform tool/catalog and EventStore-ratified runtime/profile; prove source/package/hosted parity for the enrolled workload."
    },
    {
      "id": "accountable-operators-and-identity",
      "owner": "Hexalith.Platform Administrator and named recovery deputy",
      "state": "pending",
      "question": "Bind Platform environment workload identities, OpenBao/Dapr credentials, telemetry and private GitHub notification destinations; prove operator/deputy coverage and access."
    },
    {
      "id": "recovery-targets-and-restore-drill",
      "owner": "Hexalith.Platform with Conversations and Tenants owners",
      "state": "pending",
      "question": "Inherit Platform NFR-2: continuous RPO at most one hour, RTO at most four hours within declared response coverage, 30-minute backup cadence, seven-day frequent/30-day daily retention and monthly drills. Supply state inventory/hooks and prove qualified restoration."
    },
    {
      "id": "capacity-limits-and-waivers",
      "owner": "Hexalith.Platform with Release owner",
      "state": "pending",
      "question": "Inherit Platform resource/replica policy (default one); qualify workload bounds and two-replica schedules. Record any capacity/parity waiver separately with explicit scope/expiry; no independent infrastructure choice is requested."
    },
    {
      "id": "apphost-exemption-or-relocation",
      "owner": "Hexalith baseline owner with Architect/Runtime",
      "state": "pending",
      "question": "Resolve the retained module AppHost through a named exemption or relocation before Story 16.3 entry."
    },
    {
      "id": "successor-adoption-and-scoped-execution",
      "owner": "Release owner with Planning Tooling, Architecture and Quality",
      "state": "pending",
      "question": "Approve successor contract/schema/generator/verifier adoption and a scoped current-policy entry decision; preparation grants no runtime authority."
    }
  ],
