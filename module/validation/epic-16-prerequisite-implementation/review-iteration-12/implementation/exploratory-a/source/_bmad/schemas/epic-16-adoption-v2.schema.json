        "qualifications": {
          "const": {
            "source": "pending",
            "package": "pending",
            "hosted": "pending",
            "sm2": "unverified",
            "operationalEnvelope": "pending-owner-acceptance",
            "apphostOwnership": "pending-exemption-or-relocation",
