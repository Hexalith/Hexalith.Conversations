<Project>
  <PropertyGroup>
    <!-- Inert bootstrap only. The Platform tool owns all dependency roots and mode selection. -->
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds</HexalithBuildsRoot>
  </PropertyGroup>

  <Target Name="ValidateConversationsEnrollmentMapping" BeforeTargets="PrepareForBuild;CollectPackageReferences;HexalithReconcileSourceMapping">
    <Error Condition="'$(HexalithSourceMappingHash)' == '' or '$(HexalithSourceMappingApplies)' != 'true'"
           Text="Conversations requires the Platform tool-selected source mapping; validation does not resolve dependency mappings." />
    <Error Condition="'$(UseHexalithProjectReferences)' != 'true' and '$(UseHexalithProjectReferences)' != 'false'"
           Text="The Platform mapping must select source or package references explicitly." />
    <!-- Execute the producer's loaded validation targets; selection flags alone cannot enroll a build. -->
    <CallTarget Targets="HexalithVerifySourceMappingSelection;HexalithValidateFinalSourceProjects" />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Conversations</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Conversations</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Tenant-scoped conversations module for .NET built on Hexalith architecture boundaries.</Description>
    <PackageTags>conversations;eventsourcing;dotnet;hexalith</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' and Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Source-referenced EventStore assemblies are built against the centrally governed IdentityModel
       family. Keep the four Conversations consumers on that same graph without enabling repository-wide
       transitive pinning, which would promote unrelated dependencies into packable package metadata. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Hexalith.Conversations.Server'
                     Or '$(MSBuildProjectName)' == 'Hexalith.Conversations.Server.Tests'
                     Or '$(MSBuildProjectName)' == 'Hexalith.Conversations.Conformance.Tests'
                     Or '$(MSBuildProjectName)' == 'Hexalith.Conversations.IntegrationTests'">
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
</Project>
