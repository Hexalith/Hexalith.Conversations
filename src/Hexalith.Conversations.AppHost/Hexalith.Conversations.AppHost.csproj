<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <UserSecretsId>hexalith-conversations</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Conversations.Admin.Web\Hexalith.Conversations.Admin.Web.csproj" />
    <ProjectReference Include="..\Hexalith.Conversations.Server\Hexalith.Conversations.Server.csproj" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Aspire\Hexalith.EventStore.Aspire.csproj" IsAspireProjectResource="false" Condition="'$(HexalithEventStoreRoot)' != ''" />
    <ProjectReference Include="..\..\references\Hexalith.EventStore\src\Hexalith.EventStore.Aspire\Hexalith.EventStore.Aspire.csproj" IsAspireProjectResource="false" Condition="'$(HexalithEventStoreRoot)' == ''" />
    <!-- Build-order edge only (no assembly reference): the gateway resource is composed by path through the
         public EventStore Aspire helper, so the harness must have it built in whichever configuration it
         runs. Gating this on Debug made a Release launch depend on an out-of-band prebuild. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore\Hexalith.EventStore.csproj" ReferenceOutputAssembly="false" Private="false" IsAspireProjectResource="false" Condition="'$(HexalithEventStoreRoot)' != ''" />
    <ProjectReference Include="..\..\references\Hexalith.EventStore\src\Hexalith.EventStore\Hexalith.EventStore.csproj" ReferenceOutputAssembly="false" Private="false" IsAspireProjectResource="false" Condition="'$(HexalithEventStoreRoot)' == ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <PackageReference Include="Hexalith.EventStore.Aspire" />
  </ItemGroup>
</Project>
