<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Hexalith.Conversations.Contracts</PackageId>
    <Description>Adopter-safe public contracts, schema versioning, typed errors, and compatibility metadata for Hexalith Conversations.</Description>
    <PackageTags>hexalith;conversations;contracts;compatibility;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(MSBuildProjectDirectory)\..\..\README.md" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <!-- Consume only the serialization project selected by the Platform mapping. -->
    <ProjectReference Include="$(HexalithCommonsRoot)\src\libraries\Hexalith.Commons.Serialization\Hexalith.Commons.Serialization.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'false'">
    <PackageReference Include="Hexalith.Commons.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Conversations.Contracts.Tests" />
    <InternalsVisibleTo Include="Hexalith.Conversations.Server" />
  </ItemGroup>
</Project>
