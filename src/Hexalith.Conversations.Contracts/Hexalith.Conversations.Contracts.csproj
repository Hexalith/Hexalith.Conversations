<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Hexalith.Conversations.Contracts</PackageId>
    <Description>Adopter-safe public contracts, schema versioning, typed errors, and compatibility metadata for Hexalith Conversations.</Description>
    <PackageTags>hexalith;conversations;contracts;compatibility;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(MSBuildProjectDirectory)\..\..\README.md" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Consume the promoted ruleless value-converter bases from Commons (FR-14 / Story 3.6).
         Resolves Commons from source as a root-level submodule; the dual condition mirrors the
         HexalithCommonsRoot resolution in the repository-root Directory.Build.props. -->
    <ProjectReference Include="$(HexalithCommonsRoot)\src\libraries\Hexalith.Commons.Serialization\Hexalith.Commons.Serialization.csproj" Condition="'$(HexalithCommonsRoot)' != ''" />
    <ProjectReference Include="..\..\Hexalith.Commons\src\libraries\Hexalith.Commons.Serialization\Hexalith.Commons.Serialization.csproj" Condition="'$(HexalithCommonsRoot)' == ''" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Conversations.Contracts.Tests" />
    <InternalsVisibleTo Include="Hexalith.Conversations.Server" />
  </ItemGroup>
</Project>
